# ── Сервер ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=*

# ── База данных (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/icore_mvp

# ── FastAPI / JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=замените-на-случайную-строку-минимум-32-символа
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Seed-пользователи (Node.js server.js) ───────────────────────
# Эти пароли задаются ТОЛЬКО здесь, в .env на сервере.
# Файл .env не коммитится в git (см. .gitignore).
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_PASSWORD=придумайте-надёжный-пароль

SEED_TEST_LOGIN=test
SEED_TEST_NAME=Тестовый оператор
SEED_TEST_OPERATOR_NAME=Тестовый оператор
SEED_TEST_PASSWORD=придумайте-пароль-оператора

# ── Seed-пользователи (FastAPI seed.py) ─────────────────────────
SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD — используется тот же, что выше

# ── Хранилище данных ─────────────────────────────────────────────
# DATA_FILE=/data/data.json
# PERSISTENT_DATA_DIR=/data
STATE_BACKUP_LIMIT=25
