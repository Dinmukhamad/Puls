# --- приложение ---
APP_NAME=Gamification API
DEBUG=false
TIMEZONE=Asia/Almaty

# --- база данных ---
# Локально: SQLite. Прод: postgresql+asyncpg://user:password@host:5432/gamification
DATABASE_URL=sqlite+aiosqlite:///./gamification.db
DB_ECHO=false

# --- безопасность ---
# Обязательно замените: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=8
# Единственный аккаунт с доступом к сессиям и устройствам (роль admin).
# Пустое значение отключает доступ разработчика. Через интерфейс не назначается.
DEVELOPER_LOGIN=admin

# --- CORS: список источников через запятую ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- еженедельный автоматический пересчёт (п. 5 «Автоматизация») ---
SCHEDULER_ENABLED=true
WEEKLY_CLOSE_CRON_DAY_OF_WEEK=mon
WEEKLY_CLOSE_CRON_HOUR=3
WEEKLY_CLOSE_CRON_MINUTE=0

# --- первичная инициализация ---
# В проде выключите и раскатывайте схему через alembic upgrade head
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Системный администратор

# Досоздавать справочники и учётную запись администратора при старте
SEED_REFERENCE_DATA=true
