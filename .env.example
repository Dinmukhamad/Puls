# ── FastAPI / PostgreSQL ─────────────────────────────────────────
# Railway автоматически предоставляет DATABASE_URL при подключении БД
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# JWT — сгенерируйте случайную строку: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=замените-на-случайную-строку-минимум-32-символа
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Пароли — ТОЛЬКО здесь, никогда не в коде ─────────────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=придумайте-надёжный-пароль
SEED_ADMIN_FULLNAME=Администратор

# Опционально — supervisor и manager
SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_PASSWORD=
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=

# ── Настройки ─────────────────────────────────────────────────────
CORS_ORIGINS=*
AUTO_CREATE_TABLES=true
AUTO_SEED=true
