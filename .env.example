# ══════════════════════════════════════════════════════════════
# Pulse — .env.example
# ══════════════════════════════════════════════════════════════
# ВАЖНО: скопируйте этот файл в .env и заполните реальными значениями
# НИКОГДА не коммитьте реальный .env в Git
# ══════════════════════════════════════════════════════════════

# ── DEVELOPMENT (локальная разработка) ───────────────────────
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pulse_dev
JWT_SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTO_CREATE_TABLES=true
AUTO_SEED=true
ENABLE_DEMO_DATA=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_NAME=pulse_access_token
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin_dev_password
SEED_ADMIN_FULLNAME=Администратор

# ══════════════════════════════════════════════════════════════
# PRODUCTION (Railway) — скопируйте блок ниже в Railway Variables
# ══════════════════════════════════════════════════════════════
# APP_ENV=production
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# JWT_SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
# CORS_ORIGINS=https://your-domain.railway.app
# AUTO_CREATE_TABLES=false
# AUTO_SEED=false
# ENABLE_DEMO_DATA=false
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_NAME=pulse_access_token
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=<strong unique password>
# SEED_ADMIN_FULLNAME=Администратор
# ACCESS_TOKEN_EXPIRE_MINUTES=720
