data.json
runtime-data/
secure_outputs/
operator_credentials_*.csv
operator_import_report_*.json

# ── Логи ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Системные файлы ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Редакторы ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Бэкапы и временные файлы ─────────────────────────────────────
