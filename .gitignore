node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Базы данных (локальные) ───────────────────────────────────────
icore_mvp.db
*.db
*.sqlite

# ── Хранилище состояния (реальные ФИО операторов — персданные) ───
