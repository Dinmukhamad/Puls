# Puls — переменные окружения для docker compose.
# СКОПИРУЙТЕ этот файл в deploy/.env и заполните значения:
#     cp .env.example .env
# Файл .env НЕ коммитится (см. .gitignore) — в нём секреты.

# ── База данных ──────────────────────────────────────────────
POSTGRES_USER=puls
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=puls

# ── Секрет для JWT (минимум 32 символа!) ─────────────────────
# Сгенерировать:  openssl rand -hex 32
JWT_SECRET_KEY=ЗАМЕНИТЕ_openssl_rand_hex_32

# ── Первый администратор (создаётся при первом старте) ───────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_ПАРОЛЬ_АДМИНА

# ── Прочее ───────────────────────────────────────────────────
# Домен(ы) для CORS. Если фронт и API на одном домене — можно оставить *.
CORS_ORIGINS=*
# После установки SSL (HTTPS) поставьте true — куки только по https.
AUTH_COOKIE_SECURE=false
