{
  "name": "puls-frontend-build",
  "private": true,
  "description": "Frontend bundle assembly for Puls. Readable bundles stay committed for debugging; index.html loads the hashed .min artifacts.",
  "scripts": {
    "bundle": "node scripts/build-frontend.mjs",
    "split:frontend": "powershell -ExecutionPolicy Bypass -File scripts/build-frontend.ps1 -SplitFromCurrent",
    "minify": "node scripts/minify-frontend.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "build": "npm run bundle && npm run minify && npm run stamp",
    "check:minified": "node scripts/minify-frontend.mjs --check",
    "check:stamped": "node scripts/stamp-assets.mjs --check",
    "test": "node --test tests/frontend/*.test.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "terser": "^5.36.0"
  }
}
