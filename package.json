{
  "name": "puls-frontend-build",
  "private": true,
  "description": "Deterministic source and production-minified frontend bundles for Puls.",
  "scripts": {
    "bundle": "node scripts/build-frontend.mjs",
    "minify": "node scripts/minify-frontend.mjs",
    "build": "npm run bundle && npm run minify",
    "check:minified": "node scripts/minify-frontend.mjs --check",
    "test": "node --test tests/frontend/*.test.mjs",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "terser": "^5.36.0"
  }
}
